# Python
__pycache__/
*.pyc
*.egg-info/

# Tooling
.venv/
.pytest_cache/

# Temporal dev server state (temporal server start-dev --db-filename .temporal/dev.db)
.temporal/

# Engine-owned runtime artifacts (SQLite stores, WAL/SHM sidecars, agent homes,
# node worktrees). `.ergane/` is the root as of 040-manifest-rename; `.factory/`
# is the legacy name that resolve_factory_root() still honors, so both stay
# ignored until every host has migrated.
.ergane/
.factory/
